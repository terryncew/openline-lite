{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openline:lite:schema:policy:v1",
  "title": "OpenLine Lite receiver policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "version", "allowed_actions", "required_evidence", "claim_rules", "max_age_seconds", "on_undecidable", "rollback_supported"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "allowed_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claim_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evidence_id", "pointer", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "evidence_id": {"type": "string", "minLength": 1},
          "pointer": {"type": "string", "pattern": "^($|/)"},
          "expected": {}
        }
      }
    },
    "max_age_seconds": {"type": "integer", "minimum": 0},
    "on_undecidable": {"enum": ["QUARANTINE", "NO_BADGE"]},
    "rollback_supported": {"type": "boolean"}
  }
}
