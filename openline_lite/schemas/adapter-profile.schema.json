{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openline:lite:schema:adapter-profile:v1",
  "title": "OpenLine Lite mapped Ed25519 JSON adapter profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "source_format", "signed_object", "proof", "fields", "evidence_fields"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "source_format": {"type": "string", "minLength": 1},
    "signed_object": {"type": "string", "pattern": "^/"},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "public_key", "signature"],
      "properties": {
        "algorithm": {"type": "string", "pattern": "^/"},
        "key_id": {"type": "string", "pattern": "^/"},
        "public_key": {"type": "string", "pattern": "^/"},
        "signature": {"type": "string", "pattern": "^/"}
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "issued_at", "run_id", "sequence", "action_type", "action_name", "action_target", "claim", "evidence"],
      "properties": {
        "issuer": {"type": "string", "pattern": "^/"},
        "issued_at": {"type": "string", "pattern": "^/"},
        "run_id": {"type": "string", "pattern": "^/"},
        "sequence": {"type": "string", "pattern": "^/"},
        "action_type": {"type": "string", "pattern": "^/"},
        "action_name": {"type": "string", "pattern": "^/"},
        "action_target": {"type": ["string", "null"], "pattern": "^/"},
        "claim": {"type": "string", "pattern": "^/"},
        "evidence": {"type": "string", "pattern": "^/"}
      }
    },
    "evidence_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "media_type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 1},
        "media_type": {"type": ["string", "null"]}
      }
    }
  }
}
